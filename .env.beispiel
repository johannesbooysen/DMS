# ===========================================================================
# Betriebskonfiguration (ADR 0007) -- Vorlage
# ===========================================================================
#
# Kopieren nach `.env`, ausfuellen, Rechte setzen: `chmod 600 .env`.
# Die Datei ist in `.gitignore` und in `.dockerignore` -- sie gehoert weder
# ins Repository noch ins Image.
#
# `docker compose` liest sie zweimal: einmal fuer die Platzhalter in
# `compose.yaml` und einmal als `env_file` in die Container.


# ---------------------------------------------------------------------------
# Pflicht -- ohne diese vier startet der Verbund nicht
# ---------------------------------------------------------------------------

# Datenbankpasswort. Lang und zufaellig; es wird nirgends eingetippt.
#   openssl rand -base64 36
POSTGRES_PASSWORT=

# Unter welchem Namen das System erreichbar ist. Caddy holt dafuer das
# Zertifikat -- der Name muss also wirklich auf diesen Server zeigen.
DMS_DOMAENE=dms.example.de

# Dieselbe Adresse mit Schema, fuer die Links in Mails und fuer die
# Ruecksprungadresse der Anmeldung.
#
# **Ohne diese Variable entsteht keine Sammelmail.** Ein Link ins Leere
# kostet den Empfaenger zweimal Zeit (Konzept 24.9).
DMS_BASIS_URL=https://dms.example.de

# Schluessel fuer die Sitzungskennungen.
#   openssl rand -hex 32
DMS_SITZUNGS_GEHEIMNIS=


# ---------------------------------------------------------------------------
# Anmeldung (Entra ID, ADR 0004)
# ---------------------------------------------------------------------------
#
# **`DMS_ANMELDUNG` bleibt hier leer.** Der Wert `entwicklung` wirkt nur,
# solange `NODE_ENV` nicht auf `production` steht -- im Image steht es
# darauf, die Entwicklungsanmeldung ist also ohnehin aus. Die Variable
# trotzdem nicht zu setzen ist der zweite Riegel: Eine Konfiguration wird
# kopiert, und dann wandert sie mit.
DMS_ANMELDUNG=

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Objektspeicher
# ---------------------------------------------------------------------------
#
# **Der Eimer muss mit Object Lock angelegt worden sein** -- nachtraeglich
# einschalten geht nicht (ADR 0006). Ohne `DMS_S3_EIMER` faellt das System
# auf das Dateiverzeichnis zurueck und laeuft weiter, aber ungeschuetzt:
# `archiv_eintrag.storage_object_lock_bis` bleibt dann leer.
#
# Gleicher Anbieter und gleicher Standort wie dieser Server -- jedes
# Seitenbild geht durch den Webprozess (docs/messungen.md).
#
# Fuer Hetzner Object Storage (Standort Nuernberg):
#   DMS_S3_ENDPUNKT=https://nbg1.your-objectstorage.com
#   DMS_S3_REGION=nbg1
#   DMS_S3_PFADFORM=nein      <- Pflicht: Hetzner kennt nur die Unterdomaenenform
# Den Eimer **mit Object Lock** anlegen:
#   aws s3api create-bucket --bucket <name> --region nbg1 \
#     --endpoint-url https://nbg1.your-objectstorage.com --object-lock-enabled-for-bucket
# Danach `npm run inbetriebnahme`: Es prueft nicht die Einstellung, es sperrt
# ein Probeobjekt und liest es zurueck.
DMS_S3_EIMER=
DMS_S3_SCHLUESSEL=
DMS_S3_GEHEIMNIS=
DMS_S3_ENDPUNKT=
DMS_S3_REGION=
# `nein` schaltet auf die Unterdomaenenform um; Vorgabe ist die Pfadform
# (MinIO). Hetzner braucht `nein`.
DMS_S3_PFADFORM=

# Rueckfall im Dateisystem, falls kein S3 eingerichtet ist. Der Pfad liegt
# im Container auf einem Volume.
DMS_ABLAGE=/app/.ablage


# ---------------------------------------------------------------------------
# Postausgang
# ---------------------------------------------------------------------------
#
# Ohne `SMTP_URL` gibt es keinen Versand; das Ausgangsbuch fuellt sich dann
# und bleibt liegen. Das ist ein zulaessiger Zustand, aber ein sichtbarer.
SMTP_URL=
DMS_ABSENDER=


# ---------------------------------------------------------------------------
# Texterkennung und Extraktion -- beide mit Vorgabe "aus"
# ---------------------------------------------------------------------------
#
# `ocrmypdf` liegt im Image. `tesseractjs` braucht keine Installation
# (Tesseract als WebAssembly, Sprachdaten beim ersten Lauf nach
# DMS_OCR_SPRACHDATEN, Vorgabe .tesseract/) -- fuer Rechner ohne ocrmypdf.
# `keine` (Vorgabe) laesst Belege ohne Textlayer ohne Erkennung durch --
# gemeldet wird das, nicht verschwiegen.
DMS_OCR=ocrmypdf
DMS_OCR_SPRACHE=deu
DMS_OCR_ZEITLIMIT_S=
DMS_OCR_SPRACHDATEN=
DMS_OCR_SPRACHQUELLE=

# `ollama` oder leer (Vorgabe `keiner`). Ohne Extraktion startet der
# Workflow trotzdem, die Erfassung erfolgt dann von Hand.
DMS_EXTRAKTION=
DMS_OLLAMA=
DMS_OLLAMA_MODELL=


# ---------------------------------------------------------------------------
# Eingangsquellen
# ---------------------------------------------------------------------------
#
# **Hier stehen die Passwoerter der Mailpostfaecher** -- und nur hier. Die
# Datenbank traegt in `eingangsquelle.einstellungen` den *Namen* dieser
# Variablen, nie ihren Wert; die Einrichtungsmaske hat deshalb gar kein
# Passwortfeld. Ein Name je Quelle, frei gewaehlt, zum Beispiel:
#
#   DMS_QUELLE_RECHNUNGEN=...
#
# Fehlt die Variable auf diesem Server, steht die Quelle sichtbar still.


# ---------------------------------------------------------------------------
# Fassung
# ---------------------------------------------------------------------------
#
# Wird ins Image gebaut und steht im Lebenszeichen. So ist beantwortbar,
# welcher Stand gerade laeuft -- ohne in den Container zu sehen.
#   DMS_FASSUNG=$(git rev-parse --short HEAD)
DMS_FASSUNG=

# Stapelscan: Welcher Barcode ein Trennblatt kennzeichnet (regulaerer Ausdruck,
# Gross-/Kleinschreibung egal). Leer: jeder Barcode auf einer fast leeren Seite.
# DMS_TRENNBARCODE=^TRENN
