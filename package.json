{
  "name": "dms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dokumentenmanagementsystem für die Immobilienverwaltung",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"next dev\" \"tsx watch src/worker/index.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:stand": "node scripts/stand-erzeugen.mjs",
    "docs:check": "node scripts/doku-pruefen.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "pdf-lib": "^1.17.1",
    "supabase": "^2.116.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
