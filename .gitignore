# Abhängigkeiten
node_modules/
.pnpm-store/

# Build und Ausgaben
dist/
build/
.next/
out/
*.tsbuildinfo

# Tests und Werkzeuge
coverage/
.nyc_output/
playwright-report/
test-results/
.eslintcache

# Konfiguration mit Zugangsdaten — gehört nie ins Repository
.env
.env.*
# Die Vorlage traegt keine Werte und gehoert ins Repository.
!.env.beispiel
!.env.example
*.pem
*.key

# Lokale Claude-Code-Einstellungen (die Agenten unter .claude/agents/ bleiben versioniert)
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
logs/

# Echte Belege und Kundendokumente — nur synthetische Testdaten gehören ins Repository
lokale-belege/
scratch/

# Betriebssystem und Office
Thumbs.db
desktop.ini
.DS_Store
~$*

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# Lokale Ablage der Originaldateien (in Produktion S3 mit Object Lock)
.ablage/
.next/

# Ablage der E2E-Laeufe, Berichte und Spuren
.ablage-e2e/
playwright-report/
test-results/

# Sicherungen. Sie enthalten den vollstaendigen Datenbestand -- Namen,
# Adressen, Bankverbindungen. Nichts davon gehoert in ein Repository, und
# ein einmal committetes Abbild bekommt man aus der Historie nicht mehr
# heraus.
/sicherung/

# Bestandsaufnahme der Oberflaeche -- Artefakte, kein Quelltext.
bilder/
